import QtQuick

NotesConsole {
    property string s0Spacing: {{s0Spacing}}
    property string s1Heading: {{s1Heading}}

    comfortable: s0Spacing === "Comfortable"
    redHeading: s1Heading === "Accent"
    property string palette: {{palette}}
    property int editorHeight: {{editorHeight}}
    property int titleSize: {{titleSize}}
    property string listDensity: {{listDensity}}
    property int visibleNotes: {{visibleNotes}}
    property string newNotePosition: {{newNotePosition}}
    property string textCount: {{textCount}}
    property bool showNumbers: {{showNumbers}}

    writingHeight: editorHeight
    headingSize: titleSize
    density: listDensity
    listRows: visibleNotes
    prependNewNotes: newNotePosition === "Top"
    counterMode: textCount
    numbered: showNumbers
    property color backgroundColor: {{backgroundColor}}
    property color textColor: {{textColor}}
    property color accentColor: {{accentColor}}

    paletteName: palette
    customBackground: backgroundColor
    customText: textColor
    customAccent: accentColor
}
