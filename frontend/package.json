{
  "name": "chaldea-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1",
    "build": "bunx --bun svelte-check --tsconfig ./tsconfig.json && bunx --bun tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview --host 127.0.0.1",
    "export": "bun scripts/export.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@fontsource/faculty-glyphic": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "ajv": "8.20.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.3.10",
    "playwright": "1.56.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
