{
  "name": "chaldea-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1",
    "typecheck": "bunx --bun tsc --noEmit",
    "check": "bun run typecheck && bun test tests/unit",
    "test:browser": "bun test --timeout 25000 tests/browser",
    "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview --host 127.0.0.1",
    "export": "bun scripts/export.ts",
    "native-check": "bun scripts/native-check.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
