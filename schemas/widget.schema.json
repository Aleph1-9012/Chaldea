{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "settingsSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "license": {
      "enum": [
        "MIT",
        "0BSD"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "preview": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
      "maxLength": 180
    },
    "thumbnail": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
      "maxLength": 180
    },
    "usage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
      "maxLength": 180
    },
    "settings": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default",
              "min",
              "max",
              "step"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "const": "string"
              },
              "default": {
                "type": "string"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default",
              "maxLength"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "const": "color"
              },
              "default": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "type": {
                "const": "enum"
              },
              "default": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default",
              "choices"
            ]
          }
        ]
      }
    },
    "publicFiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 180
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 180
          }
        },
        "required": [
          "source",
          "path"
        ]
      }
    },
    "exports": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 180
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 180
          },
          "kind": {
            "enum": [
              "template",
              "file"
            ]
          }
        },
        "required": [
          "source",
          "path",
          "kind"
        ]
      }
    }
  },
  "required": [
    "id",
    "title",
    "summary",
    "category",
    "tags",
    "status",
    "preview",
    "thumbnail",
    "settings",
    "publicFiles",
    "exports"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaldea.local/schemas/widget.schema.json"
}
