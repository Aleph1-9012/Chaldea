{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "settingsSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "nativeBaseline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "definition": {
      "$ref": "https://chaldea.local/schemas/widget.schema.json"
    },
    "templates": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
        "maxLength": 180
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 180
          },
          "url": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 180
          }
        },
        "required": [
          "path",
          "url"
        ]
      }
    },
    "usage": {
      "type": "string"
    }
  },
  "required": [
    "formatVersion",
    "id",
    "revision",
    "settingsSchemaVersion",
    "nativeBaseline",
    "definition",
    "templates",
    "assets",
    "usage"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
